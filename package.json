{
  "name": "localturso",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5050",
    "build": "vite build",
    "start": "node batches/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "npm run build && RUN_INTEGRATION=1 vitest run tests/integration.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx batches/migrate.ts",
    "lint": "oxlint && oxfmt --check",
    "fix:lint": "oxlint --fix && oxfmt"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "jose": "^6.1.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vinext": "^1.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tursodatabase/api": "^2.0.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-rsc": "^0.5.36",
    "drizzle-kit": "^0.31.9",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=26"
  }
}
